<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>TableStore Extend by Wlniao</Description>
    <Copyright>Copyright 2019 XieChaoyi</Copyright>
    <Authors>Wlniao</Authors>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>Wlniao.Aliyun.TableStore</AssemblyName>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <PackageId>Wlniao.Aliyun.TableStore</PackageId>
    <Version>0.1.0</Version>
    <RootNamespace>Wlniao.Aliyun.TableStore</RootNamespace>
    <PackageOutputPath>$(HOMEDRIVE)$(HOMEPATH)\.nuget</PackageOutputPath>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://www.wlniao.com/xcore/mongo</PackageProjectUrl>
		<PackageIcon>wlniao.png</PackageIcon>
  </PropertyGroup>


	<ItemGroup>
		<None Include="..\wlniao.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\Wlniao.Aliyun\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Wlniao.XCore" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Wlniao.Aliyun\Wlniao.Aliyun.csproj" />
  </ItemGroup>
</Project>
